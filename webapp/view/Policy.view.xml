<mvc:View
    controllerName="apps.dflc.benditalook.controller.Policy"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
>
    <Page id="policyPage" class="blPage">
        <customHeader>
            <core:Fragment fragmentName="apps.dflc.benditalook.view.fragments.StoreHeader" type="XML" />
        </customHeader>
        <content>
            <VBox class="blContainer blPolicy">
                <Title text="{i18n>policiesTitle}" level="H1" titleStyle="H2" class="blSectionTitle" />

                <List
                    id="policyList"
                    items="{path: 'catalog>/StorePolicies', parameters: {$select: 'Slug,Type', $orderby: 'SortOrder,Title'}, templateShareable: false}"
                    visible="{= !${policy>/hasSelection} }"
                    class="blPolicyList"
                    updateFinished=".onPolicyListUpdated"
                >
                    <StandardListItem
                        title="{catalog>Title}"
                        type="Navigation"
                        press=".onOpenPolicy"
                        class="blPolicyItem"
                    />
                </List>

                <VBox id="policyContent" visible="{policy>/hasSelection}" class="blPolicyContent">
                    <Button text="{i18n>policyBackToList}" icon="sap-icon://nav-back" type="Transparent" press=".onBackToList" />
                    <Title text="{catalog>Title}" level="H2" wrapping="true" class="blPolicyHeading" />
                    <Text text="{catalog>Content}" renderWhitespace="true" wrapping="true" class="blPolicyText" />
                </VBox>

                <MessageStrip
                    text="{i18n>noPolicies}"
                    type="Information"
                    showIcon="true"
                    visible="{policy>/isEmpty}"
                    class="sapUiMediumMarginTop"
                />
            </VBox>

            <core:Fragment fragmentName="apps.dflc.benditalook.view.fragments.StoreFooter" type="XML" />
        </content>
    </Page>
</mvc:View>
