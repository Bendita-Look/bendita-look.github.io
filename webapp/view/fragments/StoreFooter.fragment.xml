<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <VBox class="blFooter">
        <FlexBox wrap="Wrap" justifyContent="SpaceBetween" class="blFooterContent">
            <VBox class="blFooterColumn">
                <Image src="img/logo.webp" alt="{i18n>appTitle}" densityAware="false" class="blFooterLogo" />
                <Text text="{i18n>footerText}" class="blFooterText" />
            </VBox>
            <VBox class="blFooterColumn">
                <Title text="{i18n>footerContact}" level="H3" class="blFooterTitle" />
                <Link
                    text="{i18n>talkOnWhatsapp}"
                    visible="{= !!${store>/Whatsapp} }"
                    press=".onContactWhatsapp"
                    class="blFooterLink"
                />
                <Link
                    text="{store>/ContactEmail}"
                    visible="{= !!${store>/ContactEmail} }"
                    press=".onContactEmail"
                    class="blFooterLink"
                />
                <Text text="{store>/PickupAddress}" visible="{= !!${store>/PickupAddress} }" class="blFooterText" />
            </VBox>
            <VBox class="blFooterColumn" visible="{= !!${store>/Instagram} }">
                <Title text="{i18n>footerFollow}" level="H3" class="blFooterTitle" />
                <Link text="{store>/Instagram}" press=".onOpenInstagram" class="blFooterLink" />
            </VBox>
            <VBox class="blFooterColumn" visible="{= ${store>/Policies}.length > 0 }">
                <Title text="{i18n>footerPolicies}" level="H3" class="blFooterTitle" />
                <VBox items="{path: 'store>/Policies', templateShareable: true}">
                    <Link text="{store>Title}" press=".onOpenPolicy" class="blFooterLink" />
                </VBox>
            </VBox>
            <VBox class="blFooterColumn blFooterNewsletter">
                <Title text="{i18n>newsletterTitle}" level="H3" class="blFooterTitle" />
                <Text text="{i18n>newsletterHint}" class="blFooterText" />
                <VBox visible="{= !${newsletter>/subscribed} }">
                    <Input
                        value="{newsletter>/name}"
                        placeholder="{i18n>newsletterNamePlaceholder}"
                        maxLength="120"
                        class="blNewsletterInput"
                    />
                    <Input
                        value="{newsletter>/email}"
                        type="Email"
                        placeholder="{i18n>newsletterEmailPlaceholder}"
                        maxLength="120"
                        class="blNewsletterInput"
                    />
                    <Button
                        text="{i18n>newsletterSubscribe}"
                        type="Emphasized"
                        busy="{newsletter>/busy}"
                        press=".onNewsletterSubscribe"
                        class="blNewsletterButton"
                    />
                </VBox>
                <Text
                    text="{i18n>newsletterSubscribedThanks}"
                    visible="{= !!${newsletter>/subscribed} }"
                    class="blFooterText"
                />
            </VBox>
        </FlexBox>
        <HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap" class="blFooterBottom">
            <Text text="{i18n>footerRights}" class="blFooterSmall" />
            <Link text="{i18n>adminArea}" press=".onOpenAdmin" class="blFooterSmall" />
        </HBox>
    </VBox>
    <Button
        icon="sap-icon://discussion"
        tooltip="{i18n>talkOnWhatsapp}"
        visible="{= !!${store>/Whatsapp} }"
        press=".onContactWhatsapp"
        class="blWhatsappFab"
    />
</core:FragmentDefinition>
