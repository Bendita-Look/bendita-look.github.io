<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
    xmlns:unified="sap.ui.unified"
>
    <Dialog
        id="categoryDialog"
        title="{= ${path: 'HasActiveEntity', targetType: 'any'} ? ${i18n>editCategory} : ${i18n>newCategory} }"
        contentWidth="28rem"
        class="blDialog"
        escapeHandler=".categories.onCancelCategory"
    >
        <content>
            <form:SimpleForm id="categoryForm" editable="true" layout="ColumnLayout">
                <Label text="{i18n>categoryName}" required="true" />
                <Input value="{Name}" maxLength="60" />
                <Label text="{i18n>description}" />
                <TextArea value="{Description}" maxLength="255" rows="3" />
                <Label text="{i18n>activeInStore}" />
                <Switch state="{Active}" customTextOn="{i18n>yes}" customTextOff="{i18n>no}" />
            </form:SimpleForm>
            <VBox id="categoryImageBox" class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom">
                <Label text="{i18n>categoryImage}" />
                <Image
                    id="categoryImagePreview"
                    src="{= ${category>/categoryImagePreview} || 'img/placeholder.svg' }"
                    alt="{Name}"
                    width="100%"
                    height="9rem"
                    densityAware="false"
                    class="blCategoryImagePreview"
                />
                <HBox wrap="Wrap" class="sapUiSmallMarginTop" justifyContent="Start">
                    <unified:FileUploader
                        id="categoryImageUploader"
                        buttonOnly="true"
                        buttonText="{i18n>changeCategoryImage}"
                        icon="sap-icon://add-photo"
                        mimeType="image/jpeg,image/png,image/webp"
                        change=".categories.onCategoryImageSelected"
                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                    />
                    <Button id="removeCategoryImageButton" text="{i18n>removeCategoryImage}" press=".categories.onRemoveCategoryImage" class="sapUiTinyMarginBottom" />
                </HBox>
            </VBox>
        </content>
        <buttons>
            <Button text="{i18n>save}" type="Emphasized" press=".categories.onSaveCategory" />
            <Button text="{i18n>cancel}" press=".categories.onCancelCategory" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>
